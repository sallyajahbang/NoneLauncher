<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:label="RustCraft"
        android:supportsRtl="true"
        android:theme="@style/RustCraftTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:label="RustCraft"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified">
            <meta-data android:name="android.app.lib_name" android:value="rustcraft" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
