<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen dimmed overlay holding a centred dialog card. Shown only while tasks are running. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/progress_dialog_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_progress_dialog"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/lui_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/lui_420"
        app:layout_constraintWidth_percent="0.6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_generic_progressbar"
                android:layout_width="@dimen/lui_28"
                android:layout_height="@dimen/lui_28" />

            <TextView
                android:id="@+id/progress_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/lui_12"
                android:paddingEnd="@dimen/lui_4"
                android:textColor="@android:color/white"
                android:textSize="@dimen/lui_text_title"
                android:textStyle="bold"
                tools:text="5 tasks in progress" />

            <!-- Kept only because ProgressLayout looks it up; the task list is always expanded now -->
            <ImageView
                android:id="@+id/progress_flip_arrow"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:srcCompat="@drawable/spinner_arrow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lui_12"
            android:orientation="vertical"
            android:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
